# ==============================================================================
# OpenObserve SRE Hub - Environment Configuration
# ==============================================================================
# Fill these in Coolify's Environment Variables dashboard or rename to .env locally.

# OpenObserve Credentials & Settings
ZO_ROOT_USER_EMAIL=admin@yourdomain.com
ZO_ROOT_USER_PASSWORD=ChangeThisPasswordSecure!
OPENOBSERVE_PORT=5080

# Rust Context Shipper Settings
SHIPPER_PORT=8089
DEDUP_COOLDOWN_SECONDS=1800

# Agent Remediation Target (Aina / AGY Webhook)
AGENT_TARGET_URL=http://localhost:8000/webhook/agent-remediation
AGENT_AUTH_TOKEN=
